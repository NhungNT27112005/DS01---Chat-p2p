# Chạy local: sao chép thành .env. Không đưa secret lên Git.
SIGNAL_PORT=4001
RELAY_PORT=4002
VITE_SIGNAL_URL=http://localhost:4001
VITE_RELAY_URL=http://localhost:4002
SIGNAL_INTERNAL_URL=http://127.0.0.1:4001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bắt buộc đổi thành chuỗi ngẫu nhiên >=32 ký tự khi triển khai production.
RELAY_SECRET=ds01-local-development-only-change-before-deployment
